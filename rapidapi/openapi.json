{
  "openapi": "3.0.3",
  "info": {
    "title": "Delivery Check",
    "version": "0.1.0",
    "description": "Bounded text delivery validation. HTTP 200 can contain PASS or FAIL. Configure a deployed HTTPS server before publication."
  },
  "paths": {
    "/v1/check": {
      "post": {
        "operationId": "checkDelivery",
        "summary": "Validate a delivery bundle",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "requirements",
                  "files"
                ],
                "properties": {
                  "requirements": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 32,
                    "items": {
                      "type": "object",
                      "required": [
                        "name",
                        "kind",
                        "maxBytes"
                      ],
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "kind": {
                          "type": "string",
                          "enum": [
                            "text",
                            "json",
                            "csv"
                          ]
                        },
                        "maxBytes": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 1048576
                        },
                        "sha256": {
                          "type": "string"
                        },
                        "jsonSchema": {
                          "description": "Bounded JSON schema or boolean"
                        },
                        "csv": {
                          "type": "object"
                        }
                      }
                    }
                  },
                  "files": {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                      "type": "object",
                      "required": [
                        "name",
                        "content"
                      ],
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "content": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "allowExtraFiles": {
                    "type": "boolean"
                  }
                }
              },
              "example": {
                "requirements": [
                  {
                    "name": "result.json",
                    "kind": "json",
                    "maxBytes": 10000,
                    "jsonSchema": {
                      "type": "object",
                      "required": [
                        "ok",
                        "count"
                      ],
                      "properties": {
                        "ok": {
                          "type": "boolean"
                        },
                        "count": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  {
                    "name": "records.csv",
                    "kind": "csv",
                    "maxBytes": 10000,
                    "csv": {
                      "headers": [
                        "id",
                        "name"
                      ],
                      "minRows": 2,
                      "maxRows": 2
                    }
                  },
                  {
                    "name": "test-report.md",
                    "kind": "text",
                    "maxBytes": 10000
                  }
                ],
                "files": [
                  {
                    "name": "result.json",
                    "content": "{\"ok\":true,\"count\":2}"
                  },
                  {
                    "name": "records.csv",
                    "content": "id,name\n1,Alice\n2,Bob\n"
                  },
                  {
                    "name": "test-report.md",
                    "content": "# Test record\nTwo synthetic records checked.\n"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation report: PASS or FAIL"
          },
          "400": {
            "description": "Invalid JSON or UTF-8"
          },
          "401": {
            "description": "Gateway authentication failed"
          },
          "413": {
            "description": "Request too large"
          },
          "415": {
            "description": "Uncompressed JSON required"
          },
          "422": {
            "description": "Invalid validation contract"
          },
          "500": {
            "description": "Unexpected check failure"
          }
        }
      }
    }
  }
}
